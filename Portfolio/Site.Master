<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Portfolio.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Admin Panel</title>
    <link href="Admin_Panel/css/adminStyle.css?v=1.1" runat="server" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body>
    <form runat="server">
      <!-- Navbar -->
<nav class="navbar">
    <a id="AdminLink" runat="server" href="Admin.aspx">Profile</a>
    <a id="ServicesLink" runat="server" href="Services.aspx">Services</a>
    <a id="ResumeLink" runat="server" href="Resume.aspx">Resume</a>
    <a id="CertificatesLink" runat="server" href="Certificates.aspx">Certificates</a>
    <a id="ProjectsLink" runat="server" href="Project.aspx">Projects</a>
    <a id="BlogsLink" runat="server" href="Blog.aspx">Blogs</a>
    <a id="NpmLink" runat="server" href="Npm.aspx">NPM</a>
    <a id="ContactLink" runat="server" href="Contact.aspx">Contact</a>

    <!-- Admin info and logout -->
    <span style="float:right;">
        <asp:Label ID="lblAdmin" runat="server" Text="" Visible="false" Style="margin-right:10px;"></asp:Label>
        <asp:LinkButton ID="lnkLogout" runat="server" style="color:red;" OnClick="lnkLogout_Click" Visible="false">Logout</asp:LinkButton>
    </span>
</nav>

        <!-- Page content -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />

        <footer style="background-color:#f2f2f2; z-index: 100; padding:10px 20px; text-align:center; font-size:14px; color:#333; position:fixed; bottom:0; width:100%; box-shadow:0 -2px 5px rgba(0,0,0,0.1);">
    &copy; <% = DateTime.Now.Year %> Md Himel Hossain. All Rights Reserved. | Admin Panel
</footer>
    </form>
</body>
</html>

